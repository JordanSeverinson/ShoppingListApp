{
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-db-host;Port=5432;Database=shopping_list;Username=your_user;Password=YOUR_PASSWORD_HERE"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "ExpiryMinutes": "1440"
  },
  "Cors": {
    "AllowedOrigins": [ "https://your-domain.com" ]
  },
  "App": {
    "FrontendBaseUrl": "https://your-domain.com"
  },
  "AllowedHosts": "your-domain.com;www.your-domain.com;api.your-domain.com",
  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": "587",
    "EnableSsl": true,
    "Username": "your-smtp-username",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromAddress": "noreply@your-domain.com",
    "FromName": "Cook In Shop Out"
  }
}
